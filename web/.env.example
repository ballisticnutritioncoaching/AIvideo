# Stripe (Dashboard > Developers > API keys). Use sk_test_ while testing, sk_live_ to take real payments.
STRIPE_SECRET_KEY=
# Optional: a Price ID from a Product you create in Stripe. If blank, the app charges CONFIG.priceUsd ($27).
STRIPE_PRICE_ID=
# From Dashboard > Developers > Webhooks, endpoint https://YOUR-DOMAIN/api/stripe/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Your live site address, e.g. https://program.trainballistic.com (used for Stripe's return links)
NEXT_PUBLIC_SITE_URL=
# Supabase (Project Settings > API). The URL and publishable key are public; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
